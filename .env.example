# Confluence Base URL (required)
CONFLUENCE_BASE_URL=https://confluence.example.com

# --- Confluence Cloud ---
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# Both CONFLUENCE_USERNAME (your email) and PAT (API token) are required for Cloud.
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net
# CONFLUENCE_USERNAME=you@example.com
# PAT=your-api-token

# --- Confluence Server / Data Center (7.9+) ---
# Only the PAT is needed. Bearer auth is used automatically.
PAT=your-personal-access-token

# --- Basic Authentication (fallback for older Server versions) ---
# CONFLUENCE_USERNAME=your-username
# CONFLUENCE_PASSWORD=your-password

# --- Security controls ---
# Read-only mode is enabled by default. Set to false to allow mutating tools.
# CONFLUENCE_READ_ONLY=true

# Destructive tools (delete page/space, set permissions) are disabled by default.
# Set to true only when you explicitly need those operations.
# CONFLUENCE_ENABLE_DESTRUCTIVE_TOOLS=false

# Optional comma-separated allowlist of tool names to expose.
# Example:
# CONFLUENCE_ENABLED_TOOLS=confluence_get_page,confluence_search_pages

# Optional comma-separated allowlist of space keys.
# Requests that include spaceKey/destinationSpaceKey outside this list are blocked.
# Example:
# CONFLUENCE_ALLOWED_SPACES=ENG,HR

# HTTPS is required by default. For localhost-only development with http://,
# explicitly opt in by setting this to true.
# CONFLUENCE_ALLOW_INSECURE_HTTP=false

# Optional client-side max size for confluence_upload_attachment (bytes).
# Defaults to 52428800 (50 MB). Confluence may still reject larger files
# based on the instance Attachment Maximum Size setting.
# CONFLUENCE_MAX_ATTACHMENT_BYTES=52428800

# Optional security setting to restrict which directories the MCP server is allowed
# to read files from when using confluence_upload_attachment.
# Comma-separated list of absolute paths. If not set, file uploads are disabled.
# CONFLUENCE_UPLOAD_ALLOWED_DIRS=/tmp/confluence-uploads,/var/lib/assets
