# Confluence Base URL (required)
CONFLUENCE_BASE_URL=https://confluence.example.com

# --- Confluence Cloud ---
# Generate an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# Both CONFLUENCE_USERNAME (your email) and PAT (API token) are required for Cloud.
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net
# CONFLUENCE_USERNAME=you@example.com
# PAT=your-api-token

# --- Confluence Server / Data Center (7.9+) ---
# Only the PAT is needed. Bearer auth is used automatically.
PAT=your-personal-access-token

# --- Basic Authentication (fallback for older Server versions) ---
# CONFLUENCE_USERNAME=your-username
# CONFLUENCE_PASSWORD=your-password
